[node name="PowerupsText" type="Label" parent="VBoxContainer/HBoxContainer/Powerups/HBoxContainer/PowerupsMargin"]
custom_minimum_size = Vector2(350, 1)
layout_mode = 2
size_flags_vertical = 1
text = "Das is providing the Das Blast, a wide area effect that will banish any alien students it hits


Lawlor has been struggling with lag, in an effort to make the most of the situation he sends Lawlor Lag, an effect that slows time to a quarter its normal speed for five seconds


Schwartz supports Das' battle for his lunch by sending Schwartz Shot which removes the ammo limitations of the Das-cannon"
label_settings = ExtResource("2_oeru5")
autowrap_mode = 2

[node name="PowerupsMargin2" type="MarginContainer" parent="VBoxContainer/HBoxContainer/Powerups/HBoxContainer"]
layout_mode = 2
theme_override_constants/margin_left = 150
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20

[node name="PowerupsText" type="Label" parent="VBoxContainer/HBoxContainer/Powerups/HBoxContainer/PowerupsMargin2"]
custom_minimum_size = Vector2(350, 1)
layout_mode = 2
size_flags_vertical = 1
text = "Chappell isnt entirley sure what is happening but he advises Das that sometimes the best way to defend your lunch is to start Chomping. When Das uses Chappell Chomp he becomes invincible for five seconds


Jena sees Das' struggle and sends the Jena Juggernaut. An effect that overcharges the Das-shield allowing it to take one more hit. Unfortunatley the Das-shield can never store more than 3 shields at any one time."
label_settings = ExtResource("2_oeru5")
autowrap_mode = 2

