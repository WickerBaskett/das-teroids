[node name="ControlsText" type="Label" parent="VBoxContainer/HBoxContainer/Controls/ControlsMargin"]
custom_minimum_size = Vector2(350, 1)
layout_mode = 2
text = "As Das boards the Das-ship he remembers how to control it. By pressing the Up and Down arrows keys he can move the ship forwards and backwards respectivley. When he presses the Left and Right arrow keys he can turn the ship left to right.

Looking around he sees his Das-cannon, a state of the art weapon that holds three shots, if there is missing ammo it begins reloading which takes 2 seconds per ammo. To fire the Das-cannon press space.

He also has his Das-shield which will protect from one alien per charge and recharges over 5 seconds
"
label_settings = ExtResource("2_oeru5")
autowrap_mode = 2

